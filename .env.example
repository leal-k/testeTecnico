# Exemplo de configuração local. Copie para .env se quiser mudar algo:
#   cp .env.example .env
# O Docker Compose lê o .env automaticamente. NÃO são segredos reais: são
# credenciais de desenvolvimento, as mesmas já usadas por padrão.

# ---- Portas no host (mude se alguma já estiver em uso na sua máquina) ----
# Fixas, de propósito: 8080 (Keycloak; faz parte do emissor dos tokens,
# http://localhost:8080) e 8081-8083 (as três instâncias; usadas pelos
# exemplos, pela demonstração e pelo teste de carga).
POSTGRES_PORT=5432
MINISTACK_PORT=4566
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---- PostgreSQL ----
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=testetecnico

# ---- Keycloak (console de administração em http://localhost:8080) ----
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# ---- Grafana (http://localhost:3000; o dashboard abre sem login) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Aplicação ----
# Quantidade de instâncias (as portas no host vão de 8081 a 8083).
APP_REPLICAS=3
LOG_LEVEL=info
# Prazo máximo para uma referência chegar antes da rejeição.
REFERENCE_TTL=5m

# ---- SQS (MiniStack) ----
# Credenciais usadas pela aplicação para acessar a fila (valores de desenvolvimento).
SQS_ACCESS_KEY_ID=test
SQS_SECRET_ACCESS_KEY=test

# ---- Variáveis lidas pela aplicação (já definidas no docker-compose.yml) ----
# Para rodar a aplicação fora do Docker (go run ./cmd/app), exporte estas:
# DATABASE_URL=postgres://app:app@localhost:5432/testetecnico?sslmode=disable
# AUTH_ISSUER_URL=http://localhost:8080/realms/testetecnico
# AUTH_JWKS_URL=http://localhost:8080/realms/testetecnico/protocol/openid-connect/certs
# AUTH_AUDIENCE=testetecnico-api
# HTTP_ADDR=:8090
# Opcionais (com padrão): HTTP_REQUEST_TIMEOUT=15s SHUTDOWN_TIMEOUT=20s DB_MAX_CONNS=20
# PENDING_WORKER_INTERVAL=1s PENDING_BATCH_SIZE=100 REFERENCE_BACKOFF_BASE=1s REFERENCE_BACKOFF_MAX=1m
# SQS: SQS_ENABLED=true SQS_ENDPOINT_URL=http://localhost:4566 AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test
# SQS_QUEUE_NAME=wager-transactions.fifo SQS_DLQ_NAME=wager-transactions-dlq.fifo
# SQS_WAIT_TIME=10s SQS_VISIBILITY_TIMEOUT=60s SQS_HANDLE_TIMEOUT=15s SQS_MAX_MESSAGES=10
# SQS_MAX_RECEIVES=5 SQS_RETRY_BASE=2s SQS_RETRY_MAX=1m
# Outbox: OUTBOX_ENABLED=true SQS_EVENTS_QUEUE_NAME=wager-events.fifo OUTBOX_INTERVAL=500ms
# OUTBOX_BATCH_SIZE=50 OUTBOX_LEASE=30s OUTBOX_PUBLISH_TIMEOUT=5s OUTBOX_BACKOFF_BASE=1s OUTBOX_BACKOFF_MAX=1m
